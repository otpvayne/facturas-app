{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && python -m uvicorn main:app --reload --host 0.0.0.0 --port 8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd frontend && npm run dev"],
      "port": 5173
    },
    {
      "name": "portafolio-django",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd Portafolio/Portafolio-master && DEBUG=true python manage.py runserver 8000"],
      "port": 8000
    },
    {
      "name": "portafolio-next",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd portafolio-next && npm run dev"],
      "port": 3000
    }
  ]
}
