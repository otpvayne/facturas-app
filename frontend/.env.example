# Frontend environment variables
# ---------------------------------------------------------------------------
# Base URL of the FastAPI backend.
#
# Development:
#   Leave blank — Vite proxy handles /api → http://localhost:8000
#   (see vite.config.ts)
#
# Production (Render / Vercel / Netlify):
#   Set this to the full backend URL, e.g.:
#   VITE_API_BASE_URL=https://facturas-backend.onrender.com
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=
